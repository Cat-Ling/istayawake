<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Unique label for launchd -->
    <key>Label</key>
    <string>com.catling.wifiawake</string>

    <!-- Absolute path to the keep-alive script -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/wifiawake</string>
    </array>

    <!-- Start at boot without waiting for a login -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Respawn immediately if the script crashes or exits -->
    <key>KeepAlive</key>
    <true/>

    <!-- Throttle respawns: wait 10 s before restarting on failure -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <!-- Run as root so sysctl writes succeed -->
    <key>UserName</key>
    <string>root</string>

    <!-- Redirect stdout / stderr to the log file -->
    <key>StandardOutPath</key>
    <string>/var/log/wifiawake.log</string>

    <key>StandardErrorPath</key>
    <string>/var/log/wifiawake.log</string>

    <!-- Nice value: don't hog CPU -->
    <key>Nice</key>
    <integer>10</integer>

    <!--
        ProcessType "Background" tells launchd this is not interactive;
        it won't be suspended when the foreground app changes.
        Do NOT use "Adaptive" — that allows throttling which defeats the purpose.
    -->
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
